---
import Layout from "../layouts/Layout.astro";
import ProductCard from "../components/ProductCard.astro";
import { categorias, productosPorCategoria } from "../data/menu";

const grupos = productosPorCategoria();
---

<Layout title="Carta" description="Nuestra carta de cafés, té, pastelería y más.">
  <h1 class="mb-6 text-3xl font-bold text-amber-900">Carta</h1>

  <!-- Anclas para saltar entre categorías (sin JavaScript) -->
  <nav class="mb-8 flex flex-wrap gap-2">
    {
      categorias.map((c) => (
        <a
          href={`#${c}`}
          class="rounded-full border border-amber-900 px-3 py-1 text-sm text-amber-900 hover:bg-amber-900 hover:text-white"
        >
          {c}
        </a>
      ))
    }
  </nav>

  {
    categorias.map((c) => (
      <section id={c} class="mb-10 scroll-mt-4">
        <h2 class="mb-4 text-2xl font-semibold">{c}</h2>
        <div class="grid gap-4 sm:grid-cols-2">
          {grupos[c].map((p) => (
            <ProductCard producto={p} />
          ))}
        </div>
      </section>
    ))
  }
</Layout>
