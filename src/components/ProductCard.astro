---
import type { Producto } from "../data/types";
import { formatearPrecio } from "../data/menu";

interface Props {
  producto: Producto;
}

const { producto } = Astro.props;
---

<article class="rounded-lg border border-stone-200 bg-white p-4 shadow-sm">
  <div class="flex items-baseline justify-between gap-4">
    <h3 class="font-semibold">{producto.nombre}</h3>
    <span class="font-medium text-amber-900">{formatearPrecio(producto.precio)}</span>
  </div>
  <p class="mt-1 text-sm text-stone-600">{producto.descripcion}</p>
  {
    producto.destacado && (
      <span class="mt-2 inline-block rounded bg-amber-100 px-2 py-0.5 text-xs text-amber-900">
        Favorito
      </span>
    )
  }
</article>
