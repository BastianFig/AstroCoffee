---
const links = [
  { href: "/", label: "Inicio" },
  { href: "/carta", label: "Carta" },
  { href: "/ubicaciones", label: "Ubicaciones" },
];

const actual = Astro.url.pathname;
---

<header class="bg-amber-900 text-amber-50">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <a href="/" class="text-xl font-bold tracking-wide">☕ Cofee</a>
    <ul class="flex gap-6 text-sm">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class:list={["hover:underline", { "font-semibold underline": actual === l.href }]}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
