---
import type { Local } from "../data/types";

interface Props {
  local: Local;
}

const { local } = Astro.props;
---

<article class="rounded-lg border border-stone-200 bg-white p-5 shadow-sm">
  <h3 class="text-lg font-semibold">{local.nombre}</h3>
  <p class="text-stone-600">{local.direccion}, {local.comuna}</p>
  <p class="text-stone-600">📞 {local.telefono}</p>

  <dl class="mt-3 text-sm">
    {
      local.horario.map((h) => (
        <div class="flex justify-between border-t border-stone-100 py-1">
          <dt>{h.dias}</dt>
          <dd class="text-stone-600">{h.horas}</dd>
        </div>
      ))
    }
  </dl>

  <a
    href={local.mapsUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="mt-4 inline-block rounded bg-amber-900 px-4 py-2 text-sm text-white hover:bg-amber-800"
  >
    Ver en el mapa
  </a>
</article>
